---
interface Props {
  name: 'phone' | 'mail' | 'pin';
  class?: string;
}
const { name, class: className = 'h-4 w-4' } = Astro.props as Props;

const paths: Record<Props['name'], string> = {
  phone: 'M5 4h3l1.5 4L7.5 9.5a11 11 0 0 0 5 5L14 12.5l4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 3 5.2 2 2 0 0 1 5 4Z',
  mail: 'M4 6h16v12H4V6Zm0 0l8 6 8-6',
  pin: 'M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
};
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className}>
  <path d={paths[name]} stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
