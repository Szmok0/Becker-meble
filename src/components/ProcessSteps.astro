---
import process from '../data/process.json';
import ProcessIcon from './icons/ProcessIcon.astro';
---

<section class="container-page py-12 sm:py-16 border-t border-ink/5">
  <p class="eyebrow mb-4">{process.eyebrow}</p>
  <h2 class="font-serif text-4xl sm:text-5xl text-ink mb-8 max-w-xl">{process.heading}</h2>

  <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-6">
    {process.steps.map((step) => (
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-3 mb-1">
          <span class="flex h-11 w-11 items-center justify-center rounded-full border border-ink/20 text-sm text-ink/70">
            {step.number}
          </span>
          <ProcessIcon name={step.icon} class="h-7 w-7 text-bark" />
        </div>
        <h3 class="font-serif text-2xl text-ink">{step.title}</h3>
        <p class="text-base text-ink/60 leading-relaxed">{step.description}</p>
      </div>
    ))}
  </div>
</section>
