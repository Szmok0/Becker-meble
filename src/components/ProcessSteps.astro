---
import process from '../data/process.json';
import ProcessIcon from './icons/ProcessIcon.astro';
---

<section class="container-page py-12 sm:py-16 border-t border-ink/5">
  <div class="max-w-xl mb-8 sm:mb-10">
    <p class="eyebrow mb-3">{process.eyebrow}</p>
    <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-ink leading-tight whitespace-pre-line">
      {process.heading}
    </h2>
  </div>

  <div class="relative aspect-[1672/745] overflow-hidden mb-10 sm:mb-12">
    <img
      src={process.image}
      alt={process.imageAlt}
      width="1672"
      height="745"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-5 gap-x-6 gap-y-8 sm:gap-4">
    {process.steps.map((step) => (
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-full border border-ink/20 text-xs text-ink/70">
            {step.number}
          </span>
          <ProcessIcon name={step.icon} class="h-4 w-4 text-bark" />
        </div>
        <h3 class="font-serif text-lg text-ink leading-tight">{step.title}</h3>
        <p class="text-xs sm:text-[13px] text-ink/60 leading-relaxed">{step.description}</p>
      </div>
    ))}
  </div>
</section>
