---
import process from '../data/process.json';
import ProcessIcon from './icons/ProcessIcon.astro';
---

<section class="container-page py-12 sm:py-16 border-t border-ink/5">
  <div class="relative aspect-[1672/745] overflow-hidden">
    <img
      src={process.image}
      alt={process.imageAlt}
      width="1672"
      height="745"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <div class="absolute top-0 left-0 w-full sm:w-3/5 h-1/3 bg-gradient-to-br from-linen/55 via-linen/20 to-transparent pointer-events-none"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-linen/70 via-linen/25 to-transparent pointer-events-none"></div>

    <div class="absolute z-10 top-8 left-4 pt-0 px-0 sm:top-16 sm:left-8 max-w-[220px] sm:max-w-xs [text-shadow:0_1px_3px_rgba(250,247,242,0.9),0_0_16px_rgba(250,247,242,0.85)]">
      <p class="text-[10px] sm:text-xs uppercase tracking-widest2 text-ink/70 mb-1.5 sm:mb-3">{process.eyebrow}</p>
      <h2 class="font-serif text-lg sm:text-3xl lg:text-4xl text-ink leading-tight">{process.heading}</h2>
    </div>

    <div class="hidden sm:block absolute z-10 inset-x-0 bottom-0 px-8 lg:px-10 pb-6 lg:pb-8 [text-shadow:0_1px_3px_rgba(250,247,242,0.9),0_0_16px_rgba(250,247,242,0.85)]">
      <div class="flex items-center">
        {process.steps.map((step, i) => (
          <>
            <div class="flex items-center gap-2 shrink-0">
              <span class="flex h-8 w-8 items-center justify-center rounded-full border border-ink/30 bg-linen text-xs text-ink/70">
                {step.number}
              </span>
              <ProcessIcon name={step.icon} class="h-4 w-4 text-ink/70 [filter:drop-shadow(0_1px_3px_rgba(250,247,242,0.9))]" />
            </div>
            {i < process.steps.length - 1 && <span class="flex-1 h-px bg-ink/30 mx-2 lg:mx-3"></span>}
          </>
        ))}
      </div>
      <div class="grid grid-cols-5 gap-3 lg:gap-4 mt-3">
        {process.steps.map((step) => (
          <div>
            <h3 class="font-serif text-base lg:text-lg text-ink leading-tight">{step.title}</h3>
            <p class="text-[11px] lg:text-xs text-ink/70 leading-snug mt-0.5">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="sm:hidden grid grid-cols-2 gap-6 mt-8">
    {process.steps.map((step) => (
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-full border border-ink/20 text-xs text-ink/70">
            {step.number}
          </span>
          <ProcessIcon name={step.icon} class="h-4 w-4 text-bark" />
        </div>
        <h3 class="font-serif text-lg text-ink">{step.title}</h3>
        <p class="text-xs text-ink/60 leading-relaxed">{step.description}</p>
      </div>
    ))}
  </div>
</section>
