---
import realizacje from '../data/realizacje.json';
import Gallery from './Gallery.astro';

const preview = realizacje.items.slice(0, 8);
---

<section id="realizacje" class="container-page py-14 sm:py-20 border-t border-ink/5">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <div>
      <p class="eyebrow mb-4">{realizacje.eyebrow}</p>
      <h2 class="font-serif text-4xl sm:text-5xl text-ink max-w-xl">{realizacje.heading}</h2>
      {realizacje.note && (
        <p class="text-xs text-stone/80 leading-relaxed max-w-2xl mt-4 italic">{realizacje.note}</p>
      )}
    </div>
    <a
      href="/realizacje"
      class="inline-flex items-center gap-3 border border-ink/20 px-6 py-3.5 text-xs tracking-widest2 uppercase w-fit hover:border-ink hover:bg-ink hover:text-linen transition-colors shrink-0"
    >
      Zobacz wszystkie realizacje
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <Gallery items={preview} />
</section>
