---
import testimonials from '../data/testimonials.json';
---

<section id="opinie" class="container-page py-14 sm:py-20 border-t border-ink/5">
  <p class="eyebrow mb-4">{testimonials.eyebrow}</p>
  <h2 class="font-serif text-4xl sm:text-5xl text-ink mb-10 max-w-xl">{testimonials.heading}</h2>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {testimonials.items.map((t) => (
      <div class="relative flex flex-col gap-4 border border-ink/10 p-6 sm:p-8">
        {t.isPlaceholder && (
          <span class="absolute top-3 right-3 text-[9px] tracking-widest2 uppercase text-stone/70 border border-stone/30 px-2 py-0.5">
            Przykład
          </span>
        )}
        <span class="text-3xl font-serif text-walnut/40 leading-none" aria-hidden="true">&ldquo;</span>
        <p class="text-ink/70 leading-relaxed text-sm">{t.quote}</p>
        <div class="mt-auto pt-2 border-t border-ink/10 text-sm">
          <p class="text-ink font-medium">{t.author}</p>
          <p class="eyebrow !normal-case !tracking-normal">{t.project}</p>
        </div>
      </div>
    ))}
  </div>
</section>
