---
import testimonials from '../data/testimonials.json';

const starPath =
  'M12 2.5l2.9 6 6.6.8-4.8 4.6 1.2 6.6-5.9-3.1-5.9 3.1 1.2-6.6-4.8-4.6 6.6-.8 2.9-6z';
---

<section id="opinie" class="container-page py-14 sm:py-20 border-t border-ink/5">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
    <div>
      <p class="eyebrow mb-4">{testimonials.eyebrow}</p>
      <h2 class="font-serif text-4xl sm:text-5xl text-ink max-w-xl">{testimonials.heading}</h2>
    </div>
    <div class="flex flex-col items-start sm:items-end gap-1">
      {testimonials.ratingSummary && (
        <p class="text-sm text-ink/70 flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-walnut" aria-hidden="true"><path d={starPath}></path></svg>
          {testimonials.ratingSummary}
        </p>
      )}
      {testimonials.googleReviewUrl && (
        <a
          href={testimonials.googleReviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs tracking-wide text-stone hover:text-bark underline underline-offset-2"
        >
          Zobacz nas na Google &rarr;
        </a>
      )}
    </div>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {testimonials.items.map((t) => (
      <div class="relative flex flex-col gap-4 border border-ink/10 p-6 sm:p-8">
        {t.isPlaceholder && (
          <span class="absolute top-3 right-3 text-[9px] tracking-widest2 uppercase text-stone/70 border border-stone/30 px-2 py-0.5">
            Przykład
          </span>
        )}
        <div class="flex gap-0.5" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-walnut"><path d={starPath}></path></svg>
          ))}
        </div>
        <p class="text-ink/70 leading-relaxed text-sm">{t.quote}</p>
        <div class="mt-auto pt-2 border-t border-ink/10 text-sm">
          <p class="text-ink font-medium">{t.author}</p>
          <p class="eyebrow !normal-case !tracking-normal">{t.project}</p>
        </div>
      </div>
    ))}
  </div>
</section>
