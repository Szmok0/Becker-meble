---
import { items as categories } from '../data/categories.json';

const focusClass: Record<string, string> = {
  top: 'object-top',
  center: 'object-center',
  bottom: 'object-bottom',
};
---

<section class="container-page py-4">
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {categories.map((cat, i) => (
      <a
        href="/#kontakt"
        id={cat.id}
        class="group relative overflow-hidden aspect-[2/3]"
      >
        {i === 0 && (
          <span class="absolute top-3 left-3 z-10 bg-ink text-linen text-[10px] tracking-widest2 uppercase px-2.5 py-1">
            Zacznij tutaj
          </span>
        )}
        <img
          src={cat.image}
          alt={cat.imageAlt}
          loading="lazy"
          class={`h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 ${focusClass[cat.focus] ?? 'object-center'}`}
        />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 via-ink/25 to-transparent px-5 pt-10 pb-5">
          <h3 class="font-serif text-2xl text-linen leading-tight">{cat.title}</h3>
          <p class="text-linen/70 text-[11px] uppercase tracking-widest2 mt-1">{cat.subtitle}</p>
          <span class="mt-3 inline-block text-linen/80 group-hover:text-linen group-hover:translate-x-1 transition-all" aria-hidden="true">&rarr;</span>
        </div>
      </a>
    ))}
  </div>
</section>
