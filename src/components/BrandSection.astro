---
import brand from '../data/brand.json';
---

<section id="o-nas" class="grid sm:grid-cols-2">
  <div class="relative aspect-[4/3] sm:aspect-auto overflow-hidden">
    <img
      src={brand.image}
      alt={brand.imageAlt}
      width="1400"
      height="818"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
  </div>

  <div class="bg-charcoal text-linen flex flex-col justify-center gap-5 px-8 py-14 sm:px-14 sm:py-16">
    <p class="eyebrow !text-linen/50">{brand.eyebrow}</p>
    <h2 class="font-serif text-4xl sm:text-5xl leading-[1.1] whitespace-pre-line">{brand.heading}</h2>
    <p class="text-linen/70 leading-relaxed max-w-sm">{brand.paragraph}</p>
    <a
      href={brand.ctaHref}
      aria-label={brand.ctaLabel}
      title={brand.ctaLabel}
      class="mt-2 flex h-14 w-14 items-center justify-center rounded-full bg-linen text-ink hover:bg-walnut hover:text-linen transition-colors"
    >
      <span aria-hidden="true" class="text-lg">&rarr;</span>
    </a>
  </div>
</section>
