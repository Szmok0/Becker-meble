---
import hero from '../data/hero.json';
---

<section id="top" class="container-page pt-6 sm:pt-8 pb-4">
  <div class="relative h-[500px] sm:h-[580px] lg:h-[650px] overflow-hidden">
    <img
      src={hero.image}
      alt={hero.imageAlt}
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink/70 via-ink/35 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/45 via-transparent to-transparent"></div>

    <div class="relative z-10 h-full flex flex-col justify-center gap-6 p-8 sm:p-12">
      <p class="text-xs uppercase tracking-widest2 text-linen/70">{hero.eyebrow}</p>
      <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl leading-[1.05] text-linen whitespace-pre-line max-w-2xl">
        {hero.headline}
      </h1>
      <p class="text-linen/80 max-w-sm leading-relaxed">{hero.description}</p>
      <a
        href={hero.ctaHref}
        class="inline-flex items-center gap-3 bg-linen text-ink px-6 py-4 text-xs tracking-widest2 uppercase w-fit hover:bg-walnut hover:text-linen transition-colors"
      >
        {hero.ctaLabel}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="absolute bottom-0 right-0 z-10 bg-ink/70 backdrop-blur-sm text-linen px-6 py-6 text-[11px] tracking-widest2 leading-relaxed hidden sm:block">
      {hero.badge.lines.map((line) => <span class="block">{line}</span>)}
    </div>
  </div>
</section>
