---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Dziękuję">
  <Header />
  <main class="container-page py-24 sm:py-32 max-w-xl text-center flex flex-col items-center gap-6">
    <p class="eyebrow">Dziękuję</p>
    <h1 class="font-serif text-4xl sm:text-5xl text-ink">Otrzymałem Twoją wiadomość.</h1>
    <p class="text-ink/70 leading-relaxed">
      Odezwę się najszybciej, jak to możliwe. Jeśli sprawa jest pilna, zadzwoń do mnie bezpośrednio.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-3 bg-ink text-linen px-6 py-4 text-xs tracking-widest2 uppercase hover:bg-bark transition-colors"
    >
      Wróć na stronę główną
      <span aria-hidden="true">&rarr;</span>
    </a>
  </main>
  <Footer />
</BaseLayout>
