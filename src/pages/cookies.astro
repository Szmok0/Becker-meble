---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Cookies">
  <Header />
  <main class="container-page py-20 max-w-2xl">
    <h1 class="font-serif text-4xl text-ink mb-6">Polityka cookies</h1>
    <p class="text-ink/70 leading-relaxed">
      Treść polityki cookies zostanie uzupełniona przed uruchomieniem strony.
    </p>
  </main>
  <Footer />
</BaseLayout>
